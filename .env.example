# ---------------------------------------------------------------------------
# website — copy to website/.env
# ---------------------------------------------------------------------------
# This app holds NO database and NO R2 credentials. It reaches everything over
# HTTP through backend/api. If you find yourself wanting DATABASE_URL here,
# something has imported @buildkart/database that should not have.
#
# Next loads this file on its own; there is no dotenv call in next.config.mjs.

# Where backend/api listens. Must include the scheme (http:// or https://).
# On Railway private network (preferred):
#   http://backend-api.railway.internal:3002
# Via public custom domain:
#   https://api.buildkart.co
API_URL="http://127.0.0.1:3002"

# Proves this app is one of ours. Must match SERVICE_TOKEN in backend/.env
# exactly, or every request is refused.
SERVICE_TOKEN=""

# The public origin this storefront is reached at. Used for canonical URLs, the
# sitemap and Open Graph images — everything that must be absolute.
#
# The API cannot supply this: it may be reached at a private Railway hostname
# and has no idea what domain the browser used. Getting it wrong is worse than
# leaving it unset, because a sitemap full of the wrong origin is submitted to
# Google and believed. Unset falls back to http://localhost:3000, which fails
# visibly in development and is obviously wrong in production.
SITE_URL="http://localhost:3000"
