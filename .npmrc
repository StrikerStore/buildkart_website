save-exact=true
engine-strict=true
fund=false
audit=false

# Railway's builders occasionally drop a registry connection mid-download
# (npm error ECONNRESET), which fails the whole deploy. npm's default is two
# quick retries; these give a transient reset time to clear instead.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000

# `@StrikerStore/contract` is published from the backend repository to GitHub
# Packages. `NODE_AUTH_TOKEN` must be set in CI and on Railway — a token with
# `read:packages` is enough for this app, which only ever installs it.
@StrikerStore:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
