{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "description": "BuildKart storefront — Next.js 16 + React 19 + Tailwind. Reads everything through the API.",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.6.1",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build && node postbuild.mjs",
    "start": "node start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf .next .turbo",
    "check:pins": "node scripts/check-pins.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "dependencies": {
    "@StrikerStore/contract": "0.3.0",
    "@trpc/client": "11.18.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "leaflet": "1.9.4",
    "lucide-react": "1.35.0",
    "next": "16.3.3",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.4",
    "@tailwindcss/postcss": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
